    		const kvps: Prisma.KVPCreateWithoutItemInput[] = formKVPsToDBrows(data);
        const ids = await getTagIds(tagcsv, locals.activeInventoryId);

        const safeTitle = (title.trim() || extractedTitle || "New Item").trim();
