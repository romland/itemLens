                    {/if}
                </span>
            {:else if item.subtitle}
                <span class="text-xs text-gray-500 truncate mt-0.5">{item.subtitle}</span>
            {/if}

            <!-- EAV Semantic Badges -->
            {#if item.extractedAttributes}
                <div class="flex flex-wrap gap-1 mt-1.5">
